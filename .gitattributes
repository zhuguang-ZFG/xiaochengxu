# 统一换行符为 LF（Windows 检出时自动转 CRLF，提交始终 LF）
* text=auto eol=lf

# 文本文件显式 LF
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.wxml text eol=lf
*.wxss text eol=lf
*.css text eol=lf
*.html text eol=lf

# 二进制资产不转换
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
