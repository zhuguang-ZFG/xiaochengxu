/* pages/index/index.wxss */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 24rpx;
}
.input-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.input {
  flex: 1;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}
.add-btn {
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
}
.filter {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.filter-item.active {
  color: #07c160;
  font-weight: bold;
}
.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.todo-item.done .todo-text {
  text-decoration: line-through;
  color: #999;
}
.del {
  color: #fa5151;
  padding: 8rpx 16rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
